diff --git a/tests/plugins/test_updates.py b/tests/plugins/test_updates.py
index bcdd22b..c902dfe 100644
--- a/tests/plugins/test_updates.py
+++ b/tests/plugins/test_updates.py
@@ -570,3 +570,30 @@ def test_result_of_a_windows_update_is_shown_once(tmp_path: Path, monkeypatch: p
     assert u.view()["result"]["status"] == "failed"
     u.ack()
     assert u.view()["result"] is None
+
+
+# ------------------------------------------------------------------------------------------------ managed by an app
+
+
+def test_a_copy_managed_by_an_app_does_not_update_itself() -> None:
+    install = updates.detect_install(env={"FLE_STUDIO_MANAGED_BY": "fyos-shell"}, tty=True)
+    assert install == {"kind": "managed", "source": "fyos-shell", "service": False, "launcher": ""}
+    verdict = updates.advice(install, "v9.9.9", uv=True, git=True)
+    assert verdict["can_auto"] is False
+    assert "Updates come through the app (fyos-shell)" in verdict["reason"]
+    assert verdict["command"] == ""
+
+
+def test_without_the_marker_nothing_changes() -> None:
+    assert updates.managed_by({}) == ""
+    assert updates.managed_by({"FLE_STUDIO_MANAGED_BY": "  "}) == ""
+    assert updates.detect_install(env={}, prefix=Path("/nonexistent"), direct_url=None, tty=True)["kind"] == "pip"
+
+
+def test_apply_refuses_when_managed(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    monkeypatch.setenv("FLE_STUDIO_MANAGED_BY", "fyos-shell")
+    config = Config(tmp_path)
+    service = updates.Updates(tmp_path, config, None)
+    service.state = {"app": {"version": "99.0.0", "tag": "v99.0.0"}}
+    with pytest.raises(updates.UpdateError, match="Updates come through the app"):
+        service.apply("v99.0.0")
