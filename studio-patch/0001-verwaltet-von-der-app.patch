+def managed_by(env: dict[str, str] | None = None) -> str:
+    """Name of the app that manages this copy of FLE Studio ("" when none does). A desktop app that ships FLE Studio inside its
+    package sets FLE_STUDIO_MANAGED_BY=<app>; it replaces the package with its own updates, so Studio must not update itself."""
+    env = os.environ if env is None else env
+    return env.get(MANAGED_ENV, "").strip()
