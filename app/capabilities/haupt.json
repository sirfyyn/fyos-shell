{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "haupt",
  "description": "Nur das Hauptfenster (lokale Seite ui/index.html) darf die Befehle der Hülle aufrufen. Das Inhaltsfenster (Studio, FYOS OS, fremde Seiten) hat keine Capability.",
  "windows": ["haupt"],
  "local": true,
  "permissions": [
    "core:event:default",
    "allow-info",
    "allow-update-pruefen",
    "allow-update-einspielen",
    "allow-update-zurueck",
    "allow-studio-pruefen",
    "allow-studio-neustart",
    "allow-inhalt-oeffnen",
    "allow-einstellung-setzen",
    "allow-seite-bereit"
  ]
}
