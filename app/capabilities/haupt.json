{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "haupt",
  "description": "Nur das Hauptfenster (lokale Seite ui/index.html) darf die Befehle der Hülle aufrufen. Das Inhaltsfenster (Studio, FYOS OS, fremde Seiten) hat nur die kleine Capability inhalt.json für die eigene Fehlerseite.",
  "windows": ["haupt"],
  "local": true,
  "permissions": [
    "core:event:default",
    "allow-info",
    "allow-update-pruefen",
    "allow-update-einspielen",
    "allow-update-zurueck",
    "allow-studio-pruefen",
    "allow-studio-neustart",
    "allow-inhalt-oeffnen",
    "allow-einstellung-setzen",
    "allow-seite-bereit",
    "allow-bericht-speichern",
    "allow-autostart-setzen",
    "allow-tresor-pruefen",
    "allow-geheimnis-setzen",
    "allow-geheimnis-loeschen",
    "allow-geheimnis-vorhanden",
    "allow-studio-uebernehmen"
  ]
}
