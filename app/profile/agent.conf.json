{
  "productName": "FYOS Agent",
  "identifier": "de.sirfyyn.fyos-agent",
  "bundle": {
    "shortDescription": "FYOS Agent",
    "longDescription": "FYOS Agent als Desktop-Anwendung.",
    "icon": [
      "profile/icons/agent/32x32.png",
      "profile/icons/agent/128x128.png",
      "profile/icons/agent/128x128@2x.png",
      "profile/icons/agent/icon.icns",
      "profile/icons/agent/icon.ico"
    ]
  },
  "app": {
    "security": {
      "capabilities": ["haupt", "inhalt", "agent-chat", "agent-haupt"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://fyos.sirfyyn.de/update/agent/latest.json"
      ],
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "fyos"
        ]
      }
    }
  }
}
