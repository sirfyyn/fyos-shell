# Bau- und Prüfumgebung für die Linux-Pakete (AppImage) der FYOS-Hülle.
# Debian bookworm mit Node 22 (für die lokale Tauri-CLI und Python 3 für tools/), Rust und den Tauri-2-Bibliotheken,
# dazu Xvfb und Mesa-Software-Rendering, damit `--selbsttest` ohne Bildschirm und ohne GPU läuft.
# Ziel: Abbild `fyos-shell-bau` unter 8 GB. Kein GPU-Zugriff nötig oder gewollt.
FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file pkg-config ca-certificates xdg-utils patchelf python3 \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev libdbus-1-dev \
      xvfb xauth dbus dbus-x11 libgl1-mesa-dri libglx-mesa0 x11-utils \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

# AppImage-Werkzeuge laufen ohne FUSE (im Container nicht vorhanden)
ENV APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=true
WORKDIR /work
